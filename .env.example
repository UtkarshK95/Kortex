# ─── Sanity CMS ───────────────────────────────
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token

# ─── Gemini ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Qdrant Cloud ─────────────────────────────
QDRANT_URL=your_qdrant_cluster_url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=kortex_knowledge

# ─── RAG Service ──────────────────────────────
RAG_SERVICE_URL=http://localhost:8000
WEBHOOK_SECRET=your_webhook_secret

# ─── MFE Remote URLs ──────────────────────────
# Local development
VITE_CONTENT_MFE_URL=http://localhost:3001
VITE_RAG_MFE_URL=http://localhost:3002

# Production (fill after Vercel deployment)
# VITE_CONTENT_MFE_URL=https://kortex-content.vercel.app
# VITE_RAG_MFE_URL=https://kortex-rag-mfe.vercel.app

# ─── App Ports ────────────────────────────────
SHELL_PORT=3000
CONTENT_MFE_PORT=3001
RAG_MFE_PORT=3002
RAG_SERVICE_PORT=8000
